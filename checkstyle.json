{
  "defaultSeverity": "INFO",
  "checks": [
    {
      "type": "BlockBreakingConditional"
    },
    {
      "type": "ConditionalCompilation"
    },
    {
      "type": "EmptyBlock",
      "props": {
        "tokens": [
          "CLASS_DEF",
          "ENUM_DEF",
          "ABSTRACT_DEF",
          "TYPEDEF_DEF",
          "INTERFACE_DEF",
          "OBJECT_DECL",
          "FUNCTION",
          "FOR",
          "IF",
          "WHILE",
          "SWITCH",
          "TRY",
          "CATCH"
        ],
        "option": "empty",
        "severity": "INFO"
      }
    },
    {
      "type": "NeedBraces"
    },
    {
      "type": "LeftCurly"
    },
    {
      "type": "RightCurly",
      "props": {
        "option": "same",
        "tokens": ["IF", "TRY", "CATCH"]
      }
    },
    {
      "type": "RightCurly",
      "props": {
        "option": "aloneorsingle",
        "tokens": ["OBJECT_DECL"]
      }
    },
    {
      "type": "ArrowFunction",
      "props": {
        "allowCurlyBody": true,
        "allowReturn": true,
        "allowSingleArgParens": false
      }
    },
    {
      "type": "AvoidTernaryOperator",
      "props": {
        "severity": "ERROR"
      }
    },
    {
      "type": "CodeSimilarity",
      "props": {
        "severity": "IGNORE",
        "severityIdentical": "WARNING",
        "thresholdIdentical": 30
      }
    },
    {
      "type": "DefaultComesLast",
      "props": {
        "severity": "ERROR"
      }
    },
    {
      "type": "HiddenField",
      "props": {
        "severity": "ERROR",
        "ignoreSetter": false,
        "ignoreFormat": "^$",
        "ignoreConstructorParameter": true
      }
    },
    {
      "type": "InnerAssignment",
      "props": {
        "severity": "WARNING",
        "ignoreReturnAssignments": true
      }
    },
    {
      "type": "MagicNumber"
    },
    {
      "type": "MultipleVariableDeclarations",
      "props": {
        "severity": "WARNING"
      }
    },
    {
      "type": "NestedControlFlow",
      "props": {
        "severity": "WARNING",
        "max": 5
      }
    },
    {
      "type": "NestedForDepth"
    },
    {
      "type": "NestedIfDepth",
      "props": {
        "max": 3
      }
    },
    {
      "type": "NestedTryDepth"
    },
    {
      "type": "NullableParameter",
      "props": {
        "severity": "WARNING",
        "option": "questionMark"
      }
    },
    {
      "type": "ReturnCount",
      "props": {
        "severity": "IGNORE"
      }
    },
    {
      "type": "SimplifyBooleanExpression",
      "props": {
        "severity": "ERROR"
      }
    },
    {
      "type": "SimplifyBooleanReturn",
      "props": {
        "severity": "ERROR"
      }
    },
    {
      "type": "Trace",
      "props": {
        "severity": "WARNING"
      }
    },
    {
      "type": "UnusedLocalVar",
      "props": {
        "severity": "WARNING"
      }
    },
    {
      "type": "VariableInitialisation"
    },
    {
      "type": "CommentedOutCode",
      "props": {
        "severity": "IGNORE"
      }
    },
    {
      "type": "DocCommentStyle",
      "props": {
        "lineStyle": "none",
        "startStyle": "twostars"
      }
    },
    {
      "type": "FieldDocComment",
      "props": {
        "severity": "WARNING",
        "requireParams": true,
        "fieldType": "BOTH",
        "requireReturn": true,
        "ignoreOverride": true,
        "tokens": [
          "ABSTRACT_DEF",
          "CLASS_DEF",
          "ENUM_DEF",
          "INTERFACE_DEF",
          "TYPEDEF_DEF"
        ],
        "modifier": "PUBLIC",
        "excludeNames": ["new", "toString"]
      }
    },
    {
      "type": "TODOComment",
      "props": {
        "format": "TODO|FIXME|HACK|XXX|BUG|FUTURE",
        "severity": "INFO"
      }
    },
    {
      "type": "TypeDocComment",
      "props": {
        "severity": "WARNING",
        "tokens": [
          "ABSTRACT_DEF",
          "CLASS_DEF",
          "ENUM_DEF",
          "INTERFACE_DEF",
          "TYPEDEF_DEF"
        ]
      }
    },
    {
      "type": "EmptyPackage",
      "props": {
        "severity": "ERROR",
        "enforceEmptyPackage": true
      }
    },
    {
      "type": "Interface"
    },
    {
      "type": "UnnecessaryConstructor",
      "props": {
        "severity": "WARNING"
      }
    },
    {
      "type": "AvoidStarImport",
      "props": {
        "severity": "ERROR"
      }
    },
    {
      "type": "UnusedImport",
      "props": {
        "severity": "WARNING",
        "ignoreModules": []
      }
    },
    {
      "type": "ArrayLiteral",
      "props": {
        "severity": "ERROR"
      }
    },
    {
      "type": "ERegLiteral"
    },
    {
      "type": "HexadecimalLiteral",
      "props": {
        "severity": "ERROR",
        "option": "upperCase"
      }
    },
    {
      "type": "MultipleStringLiterals",
      "props": {
        "minLength": 10,
        "allowDuplicates": 5
      }
    },
    {
      "type": "StringLiteral",
      "props": {
        "policy": "doubleAndInterpolation",
        "allowException": false,
        "severity": "ERROR"
      }
    },
    {
      "type": "RedundantAccessMeta"
    },
    {
      "type": "RedundantAllowMeta"
    },
    {
      "type": "CyclomaticComplexity",
      "props": {
        "thresholds": [
          {
            "severity": "INFO",
            "complexity": 15
          },
          {
            "severity": "WARNING",
            "complexity": 22
          },
          {
            "severity": "ERROR",
            "complexity": 40
          }
        ]
      }
    },
    {
      "type": "Final",
      "props": {
        "severity": "WARNING"
      }
    },
    {
      "type": "ModifierOrder",
      "props": {
        "severity": "ERROR",
        "modifiers": [
          "PUBLIC_PRIVATE",
          "STATIC",
          "DYNAMIC",
          "OVERRIDE",
          "INLINE",
          "FINAL",
          "MACRO"
        ]
      }
    },
    {
      "type": "PublicAccessor",
      "props": {
        "severity": "IGNORE"
      }
    },
    {
      "type": "RedundantModifier",
      "props": {
        "enforcePublicPrivate": true,
        "severity": "ERROR"
      }
    },
    {
      "type": "CatchParameterName"
    },
    {
      "type": "ConstantName"
    },
    {
      "type": "LocalVariableName",
      "props": {
        "severity": "ERROR",
        "format": "^_?[a-z][a-zA-Z0-9]*$"
      }
    },
    {
      "type": "MethodName",
      "props": {
        "severity": "ERROR",
        "format": "^[a-z][a-zA-Z0-9]*$",
        "tokens": ["PUBLIC", "PRIVATE"]
      }
    },
    {
      "type": "ParameterName",
      "props": {
        "severity": "ERROR",
        "format": "^[a-z][a-zA-Z0-9]*$"
      }
    },

    {
      "type": "TypeName",
      "props": {
        "severity": "ERROR",
        "format": "^[A-Z]+[a-zA-Z0-9]*$",
        "tokens": ["CLASS", "ENUM", "TYPEDEF"]
      }
    },
    {
      "type": "TypeName",
      "props": {
        "severity": "ERROR",
        "format": "^I[A-Z]+[a-zA-Z0-9]*$",
        "tokens": ["INTERFACE"]
      }
    },
    {
      "type": "FileLength",
      "props": {
        "severity": "WARNING",
        "max": 500,
        "ignoreEmptyLines": true
      }
    },
    {
      "type": "LineLength",
      "props": {
        "severity": "ERROR",
        "max": 105
      }
    },
    {
      "type": "MethodCount"
    },
    {
      "type": "MethodLength",
      "props": {
        "max": 200
      }
    },
    {
      "type": "ParameterNumber"
    },
    {
      "type": "Anonymous",
      "props": {
        "severity": "ERROR"
      }
    },
    {
      "type": "AvoidIdentifier",
      "props": {
        "severity": "WARNING",
        "avoidIdentifiers": []
      }
    },
    {
      "type": "Dynamic",
      "props": {
        "severity": "ERROR"
      }
    },
    {
      "type": "Return",
      "props": {
        "severity": "INFO",
        "allowEmptyReturn": true,
        "enforceReturnType": true,
        "enforceReturnTypeForAnonymous": false
      }
    },
    {
      "type": "Type",
      "props": {
        "severity": "ERROR",
        "ignoreEnumAbstractValues": true
      }
    },
    {
      "type": "VarTypeHint",
      "props": {
        "severity": "IGNORE",
        "typeHintPolicy": "infer_all"
      }
    },
    {
      "type": "ArrayAccess"
    },
    {
      "type": "EmptyLines",
      "props": {
        "severity": "WARNING"
      }
    },
    {
      "type": "ExtendedEmptyLines",
      "props": {
        "severity": "WARNING",
        "defaultPolicy": "upto",
        "max": 1,
        "none": ["betweenImports"],
        "exact": ["afterPackage", "afterImports"],
        "upto": ["beginClass", "beginEnum"],
        "skipSingleLineTypes": true
      }
    },
    {
      "type": "Indentation",
      "props": {
        "severity": "ERROR",
        "character": "    ",
        "wrapPolicy": "larger"
      }
    },
    {
      "type": "OperatorWhitespace"
    },
    {
      "type": "OperatorWrap",
      "props": {
        "severity": "IGNORE"
      }
    },
    {
      "type": "SeparatorWhitespace"
    },
    {
      "type": "SeparatorWrap",
      "props": {
        "severity": "ERROR",
        "option": "nl",
        "tokens": ["."]
      }
    },
    {
      "type": "Spacing"
    },
    {
      "type": "TabForAligning"
    },
    {
      "type": "TrailingWhitespace",
      "props": {
        "severity": "IGNORE"
      }
    },
    {
      "type": "WhitespaceAfter",
      "props": {
        "severity": "WARNING",
        "tokens": [",", ";"]
      }
    },
    {
      "type": "WhitespaceAround",
      "props": {
        "severity": "WARNING",
        "tokens": ["=", "+"]
      }
    }
  ],
  "exclude": {
    "CodeSimilarity": ["tests", "src/spdx/_internal"],
    "FieldDocComment": ["tests"],
    "MethodName": ["tests"],
    "TypeDocComment": ["tests", "src/spdx/_internal"],
    "Return": ["tests"],
    "version": 1
  },
  "version": 1
}
